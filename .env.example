# Averie Skin — copy to `.env` (never commit `.env`)
# Averie 会自己把 Key 贴进本地 .env，不要把 Key 发到聊天里。

# ── 分析引擎开关 ──────────────────────────────────────────────
# 1 = 默认 Mock（无 Key 也能跑）
# 0 = 有 DashScope Key 时走 Qwen（可在 App 内再切换）
EXPO_PUBLIC_USE_MOCK=1

# cn → qwen3-vl-plus（当前已实现）
# overseas → 预留 gemini / gpt（尚未接真实调用）
EXPO_PUBLIC_ANALYZER_MARKET=cn

# ── 百炼 / DashScope（qwen3-vl-plus）─────────────────────────
# Expo Go 客户端直连测试用（会进 JS bundle，仅本地测试！）
# 正式上线必须改成后端代理，禁止把生产 Key 打进客户端。
EXPO_PUBLIC_DASHSCOPE_API_KEY=

# 替代变量名：同样会由 app.config 注入客户端，不适合生产 Key
DASHSCOPE_API_KEY=

# ── 海外路由预留（暂未实现真实调用）──────────────────────────
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
